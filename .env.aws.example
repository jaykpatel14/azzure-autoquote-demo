# AWS / ECS production environment
# Use this as the runtime env template for ECS tasks.
# Do not commit real secrets here.

# Core app
APP_URL=https://app.example.com
NEXT_PUBLIC_APP_NAME=Azzure AutoQuote

# Database
DATABASE_URL=postgresql://autoquote:<password>@<rds-endpoint>:5432/autoquote?schema=public

# Auth
AUTH_SECRET=replace-with-a-strong-secret
AUTH_URL=https://app.example.com
AZZURE_ADMIN_EMAILS=admin@azzure.com

# OpenAI
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-5-mini
AI_REVIEW_COUNT=3

# Metals.dev live pricing
METALS_DEV_API_KEY=
METALS_DEV_BASE_URL=https://api.metals.dev/v1
METALS_DEV_CURRENCY=USD
METALS_DEV_UNIT=toz

# Internal settings encryption
APP_SETTINGS_ENCRYPTION_KEY=replace-with-a-strong-secret

# Stripe
STRIPE_SECRET_KEY=replace-with-stripe-secret
STRIPE_WEBHOOK_SECRET=replace-with-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-with-publishable-key
STRIPE_PROFESSIONAL_PRICE_ID=replace-with-price-id
STRIPE_PROFESSIONAL_PRODUCT_ID=replace-with-product-id
STRIPE_ENTERPRISE_PRICE_ID=replace-with-price-id
STRIPE_ENTERPRISE_PRODUCT_ID=replace-with-product-id

# AWS
AWS_REGION=us-east-2
S3_BUCKET=replace-with-private-s3-bucket-name

# Runtime AWS credentials are not needed on ECS when the task role is configured correctly.
