# Proxmox test environment
APP_URL=http://localhost:8585
AUTH_URL=http://localhost:8585
# Branded share-link root domain; set in docker-compose.proxmox.yml for this environment.
BRAND_ROOT_DOMAIN=azzuresolutions.com
AUTH_SECRET=replace-me-with-a-strong-secret
AZZURE_ADMIN_EMAILS=admin@azzure.com
RESEND_API_KEY=
RESEND_FROM_EMAIL="Azzure AutoQuote <no-reply@your-domain.com>"

# Database is provided by docker-compose.proxmox.yml

# AI and pricing
OPENAI_API_KEY=replace-me-with-an-openai-api-key
OPENAI_MODEL=gpt-5-mini
METALS_DEV_API_KEY=
METALS_DEV_BASE_URL=https://api.metals.dev/v1
METALS_DEV_CURRENCY=USD
METALS_DEV_UNIT=toz

# Internal settings encryption
APP_SETTINGS_ENCRYPTION_KEY=replace-me-with-a-strong-secret

# Shared secret for scheduled jobs (GitHub Actions -> /api/cron/*). Must match
# the CRON_SECRET repo secret used by .github/workflows/refresh-metal-pricing.yml.
CRON_SECRET=replace-me-with-a-strong-secret

# AWS
AWS_REGION=us-east-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Stripe
STRIPE_SECRET_KEY=replace-me-with-a-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-me-with-a-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace-me-with-a-stripe-publishable-key
