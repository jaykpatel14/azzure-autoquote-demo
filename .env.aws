# ==============================================================================
# Azzure AutoQuote MVP - AWS Production Environment Configuration (.env.aws)
# ==============================================================================
# This file contains all environment variable declarations and API credentials
# required before deploying and launching the application in AWS (ECS, App Runner,
# EKS, or EC2).
#
# SECURITY RECOMMENDATION:
# In AWS production, inject these variables via AWS Secrets Manager or AWS Systems
# Manager (SSM) Parameter Store rather than committing sensitive credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME & HOSTING
# ------------------------------------------------------------------------------
# Set to "production" to enable secure cookies, production Next.js optimizations,
# and enforce strict encryption key validation.
NODE_ENV=production

# The port on which the container/server listens (matches Dockerfile EXPOSE 8585).
PORT=8585

# Bind address for container networking in AWS (ECS/App Runner/EC2).
HOSTNAME=0.0.0.0

# The fully qualified HTTPS URL for the live web application.
# Used for:
# - Auth callbacks and CSRF origin verification (lib/security.ts)
# - Stripe Checkout success/cancel return redirects (lib/stripe.ts)
# - Email verification and password reset links (app/api/auth/*)
# - Generated quote sharing URLs (lib/account-workflow.ts)
APP_URL=https://autoquote.azzuresolutions.com

# Canonical URL for NextAuth / Auth.js v5.
AUTH_URL=https://autoquote.azzuresolutions.com

# Root domain used for Enterprise multi-tenant branded share links
# Example: If set to "azzuresolutions.com", tenant quotes resolve to "acme-jewelry.azzuresolutions.com".
# Ensure a wildcard TLS certificate (*.azzuresolutions.com) is attached to CloudFront / ALB.
BRAND_ROOT_DOMAIN=azzuresolutions.com

# Public application name displayed in browser titles and emails.
NEXT_PUBLIC_APP_NAME="AI AutoQuote"


# ------------------------------------------------------------------------------
# 2. AWS MANAGED DATABASE (Amazon RDS / Aurora PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL database connection string.
# In AWS RDS, always enforce sslmode=require and tune connection pooling:
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?schema=public&sslmode=require&connection_limit=20&pool_timeout=20
DATABASE_URL=postgresql://dbadmin:REPLACE_WITH_STRONG_RDS_PASSWORD@azzure-autoquote-prod.xxxxxxxxx.us-east-1.rds.amazonaws.com:5432/autoquote?schema=public&sslmode=require


# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (NextAuth v5 / Auth.js)
# ------------------------------------------------------------------------------
# A strong random 32-byte (or 64-character) secret used to sign session JWTs and auth cookies.
# Generate via: openssl rand -base64 32
AUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32_SECRET

# Fallback alias for NextAuth
NEXTAUTH_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32_SECRET

# Comma-separated list of administrative emails that are granted the internal AZZURE_ADMIN role.
# Allows access to /admin, tenant management, internal pricing, and health overview.
AZZURE_ADMIN_EMAILS=admin@azzuresolutions.com,ops@azzuresolutions.com

# Internal Settings Encryption Key (CRITICAL IN PRODUCTION):
# 32-byte secret passphrase used by AES-256-GCM (lib/app-settings.ts) to encrypt sensitive
# runtime keys (Stripe secrets, OpenAI keys) stored dynamically in the AppSetting database table.
# Generate via: openssl rand -base64 32
APP_SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32_ENCRYPTION_KEY


# ------------------------------------------------------------------------------
# 4. AWS S3 (Quote PDF Storage & Analysis Image Persistence)
# ------------------------------------------------------------------------------
# AWS Region where your S3 bucket, RDS, and ECS tasks are hosted.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# S3 Bucket name for storing generated Quote PDFs (quotes/<companyId>/<quoteNumber>.pdf)
# and analysis uploaded images (analysis/<companyId>/<analysisId>.<ext>).
S3_BUCKET=azzure-autoquote-production-storage

# AWS IAM Credentials:
# NOTE FOR AWS DEPLOYMENTS:
# If running on AWS ECS (Fargate/EC2) or EKS, leave these blank and assign an IAM Task Role
# with 's3:PutObject', 's3:GetObject', 's3:DeleteObject' permissions on the bucket.
# If running outside IAM Role context (e.g. standalone VM), provide explicit IAM credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=


# ------------------------------------------------------------------------------
# 5. OPENAI API (AI Vision & Jewelry Analysis Engine)
# ------------------------------------------------------------------------------
# OpenAI API Key for running multi-pass jewelry image analysis and omni-moderation.
# Requires access to vision-capable models (e.g., gpt-5-mini, gpt-4o-mini, gpt-4o).
OPENAI_API_KEY=sk-proj-REPLACE_WITH_PRODUCTION_OPENAI_API_KEY

# Default OpenAI model ID for jewelry analysis.
OPENAI_MODEL=gpt-5-mini

# Number of independent consensus review passes executed per jewelry image analysis (default: 3).
AI_REVIEW_COUNT=3


# ------------------------------------------------------------------------------
# 6. METALS.DEV API (Live Precious Metals Spot Pricing)
# ------------------------------------------------------------------------------
# API key from Metals.dev used to fetch real-time spot rates for Gold, Platinum, and Silver.
# Source: https://metals.dev
METALS_DEV_API_KEY=REPLACE_WITH_METALS_DEV_LIVE_API_KEY
METALS_DEV_BASE_URL=https://api.metals.dev/v1
METALS_DEV_CURRENCY=USD
METALS_DEV_UNIT=toz


# ------------------------------------------------------------------------------
# 7. STRIPE BILLING & SUBSCRIPTIONS (Live Mode)
# ------------------------------------------------------------------------------
# Stripe Live Secret Key (starts with sk_live_...)
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_STRIPE_LIVE_SECRET_KEY

# Stripe Webhook Signing Secret (starts with whsec_...)
# Configure endpoint in Stripe Dashboard -> Webhooks -> https://autoquote.azzuresolutions.com/api/billing/webhook
# Events to listen for: checkout.session.completed, customer.subscription.updated,
# customer.subscription.deleted, invoice.payment_succeeded, invoice.payment_failed.
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STRIPE_LIVE_WEBHOOK_SECRET

# Stripe Live Publishable Key (starts with pk_live_...)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_STRIPE_LIVE_PUBLISHABLE_KEY

# Stripe Plan Product and Price IDs (Live Mode):
# Starter Plan ($49/month, 100 quotes)
STRIPE_STARTER_PRICE_ID=price_REPLACE_WITH_LIVE_STARTER_PRICE_ID

# Professional Plan ($99/month, 500 quotes)
STRIPE_PROFESSIONAL_PRICE_ID=price_REPLACE_WITH_LIVE_PROFESSIONAL_PRICE_ID
STRIPE_PROFESSIONAL_PRODUCT_ID=prod_REPLACE_WITH_LIVE_PROFESSIONAL_PRODUCT_ID

# Enterprise Plan ($199/month, 2500 quotes)
STRIPE_ENTERPRISE_PRICE_ID=price_REPLACE_WITH_LIVE_ENTERPRISE_PRICE_ID
STRIPE_ENTERPRISE_PRODUCT_ID=prod_REPLACE_WITH_LIVE_ENTERPRISE_PRODUCT_ID

# Stripe Billing Meter Event Name for tracking quote overage events (lib/stripe-metering.ts)
STRIPE_QUOTE_OVERAGE_METER_EVENT_NAME=quote_overage


# ------------------------------------------------------------------------------
# 8. CRON & AUTOMATED LIFECYCLE SCHEDULER
# ------------------------------------------------------------------------------
# Secret token required to authenticate requests to the subscription lifecycle cron route:
# POST /api/cron/subscription-lifecycle (Header: "x-cron-secret: <SECRET>" or "Authorization: Bearer <SECRET>")
# Triggered via AWS EventBridge Scheduler / CloudWatch Scheduled Event / AWS Lambda.
# Generate via: openssl rand -hex 24
CRON_SECRET=REPLACE_WITH_RANDOM_CRON_SECRET
BILLING_LIFECYCLE_SECRET=REPLACE_WITH_RANDOM_CRON_SECRET


# ------------------------------------------------------------------------------
# 9. OPERATIONS, MANUFACTURING & EMAIL NOTIFICATIONS
# ------------------------------------------------------------------------------
# Dedicated team inbox for manufacturing order alerts, high-value quotes, and administrative notices.
PRODUCTION_TEAM_EMAIL=production@azzuresolutions.com

# External Custom King portal base URL for manufacturing order tracking and fulfillment.
CK_WEBSITE_URL=https://customking.com
